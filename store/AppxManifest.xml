<?xml version="1.0" encoding="utf-8"?>
<!-- Шаблонъ манифеста MSIX. {…} подставляетъ store\pack.ps1; Identity — изъ Partner Center → Идентификація продукта. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop rescap">

  <Identity Name="{Name}" Publisher="{Publisher}" Version="{Version}" ProcessorArchitecture="{Arch}" />

  <Properties>
    <DisplayName>Пультъ для осушителя Xiaomi</DisplayName>
    <PublisherDisplayName>{PublisherDisplayName}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Неоффиціальный пультъ для Xiaomi Smart Dehumidifier Lite (xiaomi.derh.lite) по локальной сѣти.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="ru-RU" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="Dehumidifier.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Пультъ для осушителя Xiaomi"
        Description="Неоффиціальный пультъ для Xiaomi Smart Dehumidifier Lite по локальной сѣти"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- командная строка: «Dehumidifier.exe status» изъ любой консоли -->
        <uap3:Extension Category="windows.appExecutionAlias" Executable="Dehumidifier.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="Dehumidifier.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- обычная настольная программа WinForms: UDP въ локальной сѣти къ осушителю, настройки въ профилѣ -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
